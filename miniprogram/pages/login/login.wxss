.login-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a73e8 0%, #4a90e2 32%, #f5f6fa 32%);
  padding: 0 40rpx;
  box-sizing: border-box;
}
.hero { padding: 140rpx 0 60rpx; text-align: center; color: #fff; }
.hero-logo {
  width: 140rpx; height: 140rpx; line-height: 140rpx;
  margin: 0 auto 24rpx; border-radius: 36rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 30rpx; letter-spacing: 2rpx;
}
.hero-title { font-size: 44rpx; font-weight: 600; }
.hero-sub { font-size: 26rpx; opacity: 0.85; margin-top: 12rpx; }
.login-card {
  background: #fff; border-radius: 24rpx; padding: 44rpx 36rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.08);
}
.label { font-size: 26rpx; color: #666; margin-bottom: 12rpx; }
.input {
  background: #f5f6fa; border-radius: 12rpx; padding: 22rpx;
  margin-bottom: 28rpx; font-size: 30rpx;
}
.btn {
  background: #1a73e8; color: #fff; border-radius: 12rpx;
  padding: 24rpx; text-align: center; font-size: 32rpx; margin-top: 8rpx;
}
.btn.gray { background: #a9c3e6; }
.err { color: #d93025; font-size: 26rpx; margin-top: 20rpx; text-align: center; }
.demo { margin-top: 28rpx; font-size: 24rpx; color: #1a73e8; text-align: center; }
.footer { margin-top: 50rpx; text-align: center; font-size: 22rpx; color: #999; }