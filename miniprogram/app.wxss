page {
  background: #f5f6fa;
  font-size: 28rpx;
  color: #222;
}
.container { padding: 24rpx; }
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.link { color: #1a73e8; font-size: 26rpx; }
.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 26rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.04);
}
.row { display: flex; align-items: center; justify-content: space-between; }
.title { font-size: 32rpx; font-weight: 600; }
.sub { color: #888; font-size: 24rpx; margin-top: 10rpx; }
.tip { text-align: center; color: #999; padding: 60rpx 0; }
.err { color: #d93025; line-height: 1.6; }
.tag {
  background: #e8f0fe;
  color: #1a73e8;
  border-radius: 8rpx;
  padding: 4rpx 12rpx;
  font-size: 22rpx;
}
.tag.gray { background: #eef0f3; color: #999; }
.btn {
  background: #1a73e8;
  color: #fff;
  border-radius: 12rpx;
  padding: 22rpx;
  text-align: center;
  margin-top: 24rpx;
}
.btn.gray { background: #c9d6e8; }
.input {
  background: #f5f6fa;
  border-radius: 10rpx;
  padding: 20rpx;
  margin-top: 16rpx;
}
.cancel {
  margin-top: 20rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #f5f5f5;
  text-align: center;
  color: #d93025;
  font-size: 26rpx;
}
.dept { display: flex; align-items: center; }
.dept-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex: 0 0 auto;
}
.dept-main { flex: 1; min-width: 0; }
.arrow { color: #c8ccd4; font-size: 40rpx; line-height: 1; margin-left: 12rpx; }
.notice {
  background: #fff8e6;
  border-radius: 16rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  color: #8a6d1f;
  font-size: 24rpx;
  line-height: 1.7;
}
.logout {
  background: #fff;
  color: #d93025;
  border: 1rpx solid #f0d5d3;
  margin-top: 40rpx;
}